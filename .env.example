# Copia este archivo como .env y ajusta los valores.

# PIN de acceso a la aplicación (obligatorio cambiarlo).
APP_PIN=1234

# Token para la API externa POST /api/signal.
# Si se deja vacío, la API externa queda desactivada.
# Genera uno con: openssl rand -hex 24
API_TOKEN=

# Secreto para firmar la cookie de sesión.
# Si se deja vacío, Echo genera uno aleatorio y lo guarda en SQLite.
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Zona horaria del contenedor.
TZ=Europe/Madrid
