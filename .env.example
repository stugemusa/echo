# Copia este archivo como .env y ajusta los valores.

# PIN del usuario normal (obligatorio cambiarlo).
APP_PIN=1234

# PIN del perfil de administración (ajustes, señales y API).
# Si se deja vacío, APP_PIN actúa también como administrador.
ADMIN_PIN=

# Token para la API externa POST /api/signal.
# Si se deja vacío, la API externa queda desactivada.
# Genera uno con: openssl rand -hex 24
API_TOKEN=

# Secreto para firmar la cookie de sesión.
# Si se deja vacío, Echo genera uno aleatorio y lo guarda en SQLite.
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# HTTPS opcional (Docker). Rutas a un certificado y su clave en formato PEM.
# SSL=true
# CERTFILE=/data/certs/fullchain.pem
# KEYFILE=/data/certs/privkey.pem

# Zona horaria del contenedor.
TZ=Europe/Madrid
